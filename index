            </div>
        </div>

        <div id="apk-view" class="view-container">
            <div class="apk-container">
                
                <div class="profile-picture"> 
                    <img src="https://www.dropbox.com/scl/fi/zgkkgwdmc8wl1dwylw3hj/gif_20251001_220116_010.gif?rlkey=pclrb4f24t2w68prj8j22wyh0&st=rdkbc87c&raw=1" alt="foto de perfil de VELÁSQUEZ">
                </div>

                <p>
                    **¡Hola! Soy RENNI VELÁSQUEZ.** Encuentra las últimas versiones de mis proyectos y haz clic en el enlace para descargarlos.
                </p>

                <a class="button-link" href="javascript:void(0)" 
                    onclick="showkeymodal('https://www.mediafire.com/file/5iq0dbbck8hfrit/magis_4.29.2.apk/file')">
                    <i class="fas fa-mobile-alt"></i> Instalar APK en el celular Android
                </a>

                <a class="button-link" href="javascript:void(0)" 
                    onclick="showkeymodal('https://www.mediafire.com/file/s3vkn1m4gq1n7sr/base.apk/file')">
                    <i class="fas fa-tv"></i> Instalar APK en PC, Smart TV, TVBox
                </a>

                <img class="screenshot-added" 
                    src="https://www.dropbox.com/scl/fi/m40g3ecczlx4zi3t9kylr/screenshot_20251005_235903.jpg?rlkey=sq5mlzpnss00832r5yvs8lenq&st=rdkbc87c&raw=1" 
                    alt="screenshot del repositorio adicional">
                <p class="apk-copyright">
                    © RENNI projects
                </p>
                
            </div>
        </div>

    </div>
    
    <div id="key-modal-overlay">
        <div id="key-modal-box">
            <h2 id="modal-title"></h2>
            <textarea id="message-input" placeholder="Escribe tu mensaje aquí..." style="display:none;"></textarea>
            <input type="password" id="key-input" placeholder="Clave (8 dígitos)" maxlength="8" style="display:none;">
            
            <div id="modal-actions">
                <button class="modal-button" id="modal-cancel-btn">Cancelar</button>
                <button class="modal-button" id="modal-confirm-btn">Acceder / Enviar</button>
            </div>
        </div>
    </div>
    <div id="alert-modal-overlay">
        <div id="alert-modal-box">
            <div class="icon"><i class="fas fa-exclamation-triangle"></i></div>
            <p id="alert-message"></p>
            <button class="alert-button" onclick="hideneumalert()">Entendido</button>
        </div>
    </div>
    <script>
        // === Configuración y elementos del Modal ===
        const correct_key = "11365759";
        const WHATSAPP_BASE_URL = "https://wa.me/59171664587"; 
        
        const KEY_USAGE_MARKER = 'key_used_marker'; 
        const LAST_USED_KEY = 'last_successful_key'; 

        const modalOverlay = document.getElementById('key-modal-overlay');
        const modalTitle = document.getElementById('modal-title');
        
        const keyInput = document.getElementById('key-input');
        const messageInput = document.getElementById('message-input');
        
        const confirmBtn = document.getElementById('modal-confirm-btn');
        const cancelBtn = document.getElementById('modal-cancel-btn');
        
        const alertOverlay = document.getElementById('alert-modal-overlay');
        const alertMessage = document.getElementById('alert-message');
        
        let currentMode = ''; 
        let currentTargetUrl = '';


        function hidekeymodal() {
            modalOverlay.classList.remove('is-visible');
            keyInput.value = '';
            messageInput.value = '';
            keyInput.style.display = 'none';
            messageInput.style.display = 'none';
            confirmBtn.style.backgroundColor = 'var(--link-color)'; 
            confirmBtn.style.color = '#ffffff'; 
        }

        function showneumalert(message) {
            alertMessage.textContent = message;
            alertOverlay.style.display = 'flex';
            setTimeout(() => {
                alertOverlay.querySelector('.alert-button').focus();
            }, 50);
        }

        function hideneumalert() {
            alertOverlay.style.display = 'none';
        }
        
        function showkeymodal(url) {
            currentMode = 'key';
            currentTargetUrl = url;
            
            const isKeyUsed = localStorage.getItem(KEY_USAGE_MARKER);
            const storedKey = localStorage.getItem(LAST_USED_KEY);

            if (isKeyUsed === 'true' && storedKey === correct_key) {
                 showneumalert("⚠️ Esta clave ya ha sido utilizada en este dispositivo (navegador). No se permite el reingreso.");
                 return; 
            }

            modalTitle.innerHTML = '<i class="fas fa-lock"></i> Por favor, ingresa la clave de acceso (8 dígitos):';
            keyInput.style.display = 'block';
            
            confirmBtn.textContent = 'Acceder';
            confirmBtn.style.backgroundColor = 'var(--link-color)'; 
            confirmBtn.style.color = '#ffffff'; 
            
            modalOverlay.classList.add('is-visible');
            setTimeout(() => { keyInput.focus(); }, 50); 
        }

        function attemptkeyaccess() {
            const key = keyInput.value.trim();
            
            if (key === correct_key) {
                localStorage.setItem(KEY_USAGE_MARKER, 'true');
                localStorage.setItem(LAST_USED_KEY, correct_key); 

                window.open(currentTargetUrl, '_blank');
                hidekeymodal();
                
            } else {
                showneumalert("❌ Clave incorrecta. Inténtalo de nuevo.");
                keyInput.value = '';
                keyInput.focus();
            }
        }
        
        function showwhatsappmodal() {
            currentMode = 'whatsapp';
            
            modalTitle.innerHTML = '<i class="fab fa-whatsapp"></i> Escribe tu mensaje para contactarme:';
            messageInput.style.display = 'block';
            messageInput.style.minHeight = '100px'; 
            messageInput.placeholder = "¡Hola RENNI VELÁSQUEZ! Quisiera consultarte sobre...";
            
            confirmBtn.textContent = 'Enviar a WhatsApp';
            confirmBtn.style.backgroundColor = '#25d366'; 
            confirmBtn.style.color = '#ffffff';

            modalOverlay.classList.add('is-visible');
            setTimeout(() => { messageInput.focus(); }, 50);
        }
        
        function sendwhatsappmessage() {
            const message = messageInput.value.trim();
            
            if (message.length < 5) {
                showneumalert("❌ ¡Escribe algo! Por favor, ingresa un mensaje más detallado (mínimo 5 letras).");
                messageInput.focus();
                return;
            }
            
            const encodedMessage = encodeURIComponent(message);
            const whatsappUrl = `${WHATSAPP_BASE_URL}?text=${encodedMessage}`;
            
            window.open(whatsappUrl, '_blank');
            hidekeymodal();
        }
        
        async function shareProfile() {
            const shareData = {
                title: document.title, 
                text: '¡Hola! Te comparto mi espacio personal en la web, donde puedes ver mis proyectos. ¡Visítalo ahora!',
                url: window.location.href 
            };

            if (navigator.share) {
                try {
                    await navigator.share(shareData);
                    console.log('Perfil compartido con éxito.');
                } catch (error) {
                    if (error.name !== 'AbortError') {
                        console.error('Error al compartir:', error);
                        showneumalert("Hubo un error al intentar compartir. Por favor, inténtalo de nuevo.");
                    }
                }
            } else {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    try {
                        await navigator.clipboard.writeText(shareData.url);
                        showneumalert("✅ Enlace copiado al portapapeles. ¡Compártelo ahora!");
                    } catch (err) {
                        console.error('Error al copiar (Clipboard API):', err);
                        fallbackCopyTextToClipboard(shareData.url); 
                    }
                } else {
                    fallbackCopyTextToClipboard(shareData.url);
                }
            }
        }
        
        function fallbackCopyTextToClipboard(text) {
            const tempInput = document.createElement('input');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            
            tempInput.select();
            tempInput.setSelectionRange(0, 99999); 
            
            try {
                document.execCommand('copy');
                showneumalert("✅ Enlace copiado al portapapeles. ¡Compártelo ahora!");
            } catch (err) {
                showneumalert(`❌ Tu navegador no soporta la copia automática. Copia manualmente: ${text}`);
            }
            
            document.body.removeChild(tempInput);
        }

        confirmBtn.addEventListener('click', function() {
            if (currentMode === 'key') {
                attemptkeyaccess();
            } else if (currentMode === 'whatsapp') {
                sendwhatsappmessage();
            }
        });

        cancelBtn.addEventListener('click', hidekeymodal);

        keyInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && currentMode === 'key') {
                e.preventDefault(); 
                attemptkeyaccess();
            }
        });
        
        const profileview = document.getElementById('profile-view');
        const apkview = document.getElementById('apk-view');
        
        function navigateview(targetid, pushtohistory = true) {
            if (document.activeElement) document.activeElement.blur();
            profileview.classList.remove('is-active');
            apkview.classList.remove('is-active');
            document.getElementById(targetid).classList.add('is-active');
            
            if (pushtohistory) {
                if (window.location.hash !== '#' + targetid) {
                    const newhash = (targetid === 'profile-view') ? '' : '#' + targetid;
                    history.pushState({ view: targetid }, '', window.location.pathname + newhash);
                }
            }
        }
        
        function switchview(targetid) {
            profileview.classList.remove('is-active');
            apkview.classList.remove('is-active');
            document.getElementById(targetid).classList.add('is-active');
        }

        window.addEventListener('popstate', function(event) {
            const targetview = (event.state && event.state.view) ? event.state.view : 'profile-view';
            switchview(targetview);
        });

        function initializeview() {
            const hash = window.location.hash.replace('#', '');
            if (hash === 'apk-view') {
                switchview('apk-view');
                history.replaceState({ view: 'apk-view' }, '', window.location.pathname + '#apk-view');
            } else {
                switchview('profile-view');
                history.replaceState({ view: 'profile-view' }, '', window.location.pathname);
            }
        }

        initializeview();
        
        document.addEventListener('click', function(e) {
            if (document.activeElement && 
                (document.activeElement.tagName === 'A' || document.activeElement.tagName === 'BUTTON')) {
                document.activeElement.blur(); 
            }
        });
        
        document.addEventListener('contextmenu', function(e) {
            e.preventDefault();
        });

        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        const particlescontainer = document.getElementById('particles-js');
        if (particlescontainer) particlescontainer.appendChild(canvas);
        
        let w, h, particles;
        const particle_count = 60; 

        function resizecanvas() {
            w = window.innerWidth;
            h = window.innerHeight;
            canvas.width = w;
            canvas.height = h;
        }

        class particle {
            constructor() {
                this.x = Math.random() * w;
                this.y = Math.random() * h;
                this.radius = Math.random() * 0.8 + 0.2; 
                this.vx = Math.random() * 2 - 1.0; 
                this.vy = Math.random() * 2 - 1.0; 
                this.color = "rgba(0, 0, 0, 0.4)"; 
            }

            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2, false);
                ctx.fillStyle = this.color;
                ctx.fill();
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;

                if (this.x < 0 || this.x > w || this.y < 0 || this.y > h) {
                    this.reset();
                }
                
                this.draw();
            }

            reset() {
                if (this.x < 0) this.x = w;
                else if (this.x > w) this.x = 0;
                
                if (this.y < 0) this.y = h;
                else if (this.y > h) this.y = 0;

                this.vx = Math.random() * 2 - 1.0;
                this.vy = Math.random() * 2 - 1.0;
                this.radius = Math.random() * 0.8 + 0.2; 
            }
        }

        function initparticles() {
            particles = [];
            for (let i = 0; i < particle_count; i++) {
                particles.push(new particle());
            }
        }

        function animate() {
            requestAnimationFrame(animate);
            ctx.fillStyle = 'rgba(235, 235, 235, 0.99)'; 
            ctx.fillRect(0, 0, w, h);

            for (let i = 0; i < particles.length; i++) {
                particles[i].update();
            }
        }

        window.addEventListener('resize', resizecanvas);
        resizecanvas();
        initparticles();
        animate();
    </script>
</body>
</html>
